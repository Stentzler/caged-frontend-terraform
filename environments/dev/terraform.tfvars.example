# Copy to terraform.tfvars and replace with non-secret development values.
# This file is safe to commit only as an example; your real terraform.tfvars is ignored.

# Set a component to 0 only with an approved plan: Terraform will destroy it.
enable_network = 1
enable_container_registry = 1
enable_frontend_host = 1
enable_edge_delivery = 1

aws_region          = "us-east-1"
vpc_cidr            = "10.42.0.0/16"
public_subnet_cidr  = "10.42.0.0/24"
# availability_zone = "us-east-1a"

# Copy the qualified alias ARN from the backend team's approved configuration.
# Do not use an unqualified Lambda ARN: its alias pins frontend access to a
# deliberate backend release.
query_lambda_alias_arn = "arn:aws:lambda:us-east-1:123456789012:function:caged-dev-query:dev"

# These are runtime values rendered into one SSM parameter and read only by the
# EC2 host during deployment. Use real public values in ignored terraform.tfvars.
site_official_source_url = "https://example.com/official-caged-source"
site_cbo_source_url      = "https://example.com/cbo-source"
site_github_url          = "https://github.com/example"
site_contact_email       = "contact@example.com"

# The low-cost defaults are suitable for the one-instance MVP.
instance_type        = "t3.micro"
root_volume_size_gib = 20
waf_rate_limit = 15
waf_evaluation_window_seconds = 60

common_tags = {
  Owner      = "platform"
  CostCenter = "engineering"
}
