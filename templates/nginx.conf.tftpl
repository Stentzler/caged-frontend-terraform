# CloudFront is the only permitted network caller. This second check makes the
# origin unusable unless CloudFront also presents the generated secret header.
server_tokens off;

# CloudFront-Viewer-Address has IPv4 as "address:port". CloudFront currently
# sends IPv6 without brackets followed by its port, but accept the bracketed
# form too. Anything else stays empty and is rejected below, preventing
# malformed headers from collapsing unrelated clients into one rate-limit key.
map $http_cloudfront_viewer_address $trusted_viewer_ip {
  default "";
  # Nginx treats curly braces as configuration syntax unless this regular
  # expression is quoted. The quotes preserve the IPv4 repetition ranges.
  "~^(?<trusted_ipv4>[0-9]{1,3}(?:\.[0-9]{1,3}){3}):[0-9]+$" $trusted_ipv4;
  ~^(?<trusted_ipv6_unbracketed>[0-9A-Fa-f:]+):[0-9]+$ $trusted_ipv6_unbracketed;
  ~^\[(?<trusted_ipv6>[0-9A-Fa-f:]+)\]:[0-9]+$ $trusted_ipv6;
}

# The MVP has one analytics POST workflow, so every POST is limited. GET pages
# and static assets receive an empty key and are not counted by this zone.
map $request_method $analytics_rate_limit_key {
  default "";
  POST $trusted_viewer_ip;
}

# Static cache behaviors do not need the viewer address. A POST without a
# parsed address would bypass the per-viewer rate-limit key, so reject only
# that invalid analytics request before it reaches the upstream application.
map "$request_method:$trusted_viewer_ip" $reject_untrusted_analytics_request {
  default 0;
  "POST:" 1;
}

# Fifteen requests per minute is the exact origin-level layer; WAF remains the
# earlier, approximate CloudFront layer with the same intended threshold.
limit_req_zone $analytics_rate_limit_key zone=analytics_post_limit:10m rate=15r/m;

server {
  listen 80 default_server;
  server_name _;
  client_max_body_size 1m;

  # Deployment verifies Nginx locally without requiring a public origin path.
  location = /health {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Bootstrap replaces this placeholder only on the EC2 host after reading SSM.
  if ($http_x_caged_origin_verify != "__ORIGIN_SECRET__") {
    return 403;
  }

  # GET requests can serve static assets without a viewer-address header. A
  # malformed or absent address is rejected only for analytics POST requests,
  # where accepting it would bypass the per-viewer rate limit.
  if ($reject_untrusted_analytics_request) {
    return 400;
  }

  location / {
    limit_req zone=analytics_post_limit burst=2 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
  }
}
