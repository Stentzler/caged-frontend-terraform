# This file is rendered by Terraform into one SSM String parameter. The EC2
# deployment command downloads it at runtime and passes it to Docker as an
# env-file, keeping server configuration out of the container image and GitHub.
AWS_REGION=${aws_region}
CAGED_QUERY_LAMBDA_FUNCTION_NAME=${query_lambda_alias_arn}
SITE_URL=${site_url}
SITE_OFFICIAL_SOURCE_URL=${site_official_source_url}
SITE_CBO_SOURCE_URL=${site_cbo_source_url}
SITE_GITHUB_URL=${site_github_url}
SITE_CONTACT_EMAIL=${site_contact_email}
